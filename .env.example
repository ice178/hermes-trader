# Required Telegram Bot API configuration.
TELEGRAM_BOT_TOKEN=replace-with-a-new-bot-token
TELEGRAM_CHAT_ID=replace-with-the-target-chat-id

# 1 (default): require both metrics to pass; 0: report volume/volatility only.
SIGNAL_METRIC_FILTER_ENABLED=1

# Required for the optional continuous command listener. Empty disables area
# annotations in the scanner. Production: /var/lib/hermes-trading/levels.sqlite3
LEVELS_DB_PATH=
# Comma-separated Telegram USER IDs allowed to read/manage levels (not chat IDs).
TELEGRAM_ALLOWED_USER_IDS=

# Keep TLS verification enabled. Set a custom CA path only when the host requires it.
TELEGRAM_SSL_INSECURE=0
TELEGRAM_CA_BUNDLE=
